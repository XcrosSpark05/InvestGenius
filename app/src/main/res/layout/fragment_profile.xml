<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Fragment.ProfileFragment">

    <!-- TODO: Update blank fragment layout -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView2"
                android:layout_width="match_parent"
                android:layout_height="550dp"
                android:layout_marginStart="29dp"
                android:layout_marginEnd="29dp"
                android:backgroundTint="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView13">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:elevation="10dp">

                    <EditText
                        android:id="@+id/editTextText2"
                        android:layout_width="328dp"
                        android:layout_height="55dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/input"
                        android:drawableStart="@drawable/baseline_person_24"
                        android:drawablePadding="15dp"
                        android:elevation="10dp"
                        android:ems="10"
                        android:inputType="text"
                        android:paddingStart="15dp"
                        android:text="First Name"
                        android:textColor="#000000"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/editTextText3"
                        android:layout_width="328dp"
                        android:layout_height="55dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/input"
                        android:drawableStart="@drawable/baseline_person_24"
                        android:drawablePadding="15dp"
                        android:elevation="10dp"
                        android:ems="10"
                        android:inputType="text"
                        android:paddingStart="15dp"
                        android:text="Last Name"
                        android:textColor="#000000"
                        app:layout_constraintEnd_toEndOf="@+id/editTextText2"
                        app:layout_constraintStart_toStartOf="@+id/editTextText2"
                        app:layout_constraintTop_toBottomOf="@+id/editTextText2" />

                    <EditText
                        android:id="@+id/editTextText10"
                        android:layout_width="328dp"
                        android:layout_height="55dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/input"
                        android:drawableStart="@drawable/call"
                        android:drawablePadding="15dp"
                        android:elevation="10dp"
                        android:ems="10"
                        android:inputType="number"
                        android:paddingStart="15dp"
                        android:text="123456789"
                        android:textColor="#000000"
                        app:layout_constraintEnd_toEndOf="@+id/editTextText3"
                        app:layout_constraintStart_toStartOf="@+id/editTextText3"
                        app:layout_constraintTop_toBottomOf="@+id/editTextText3" />

                    <EditText
                        android:id="@+id/editTextTextEmailAddress"
                        android:layout_width="328dp"
                        android:layout_height="55dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/input"
                        android:drawableStart="@drawable/mail"
                        android:drawablePadding="15dp"
                        android:elevation="10dp"
                        android:ems="10"
                        android:inputType="textEmailAddress"
                        android:paddingStart="15dp"
                        android:text="abc@gmail.com"
                        android:textColor="#000000"
                        app:layout_constraintEnd_toEndOf="@+id/editTextText10"
                        app:layout_constraintStart_toStartOf="@+id/editTextText10"
                        app:layout_constraintTop_toBottomOf="@+id/editTextText10" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/button9"
                        android:layout_width="152dp"
                        android:layout_height="45dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/button"
                        android:elevation="10dp"
                        android:fontFamily="@font/blinker_bold"
                        android:text="Manage Profile"
                        android:textColor="#000000"
                        app:layout_constraintStart_toStartOf="@+id/editTextTextEmailAddress"
                        app:layout_constraintTop_toBottomOf="@+id/editTextTextEmailAddress" />

                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/button10"
                        android:layout_width="152dp"
                        android:layout_height="45dp"
                        android:layout_marginTop="32dp"
                        android:background="@drawable/button"
                        android:elevation="10dp"
                        android:fontFamily="@font/blinker_bold"
                        android:text="Security"
                        android:textColor="#000000"
                        app:layout_constraintEnd_toEndOf="@+id/editTextTextEmailAddress"
                        app:layout_constraintStart_toEndOf="@+id/button9"
                        app:layout_constraintTop_toBottomOf="@+id/editTextTextEmailAddress" />

                    <TextView
                        android:id="@+id/textView28"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:fontFamily="@font/istok_web_bold"
                        android:text="LogOut"
                        android:textColor="#F10E12"
                        android:textSize="18sp"
                        app:layout_constraintEnd_toEndOf="@+id/button10"
                        app:layout_constraintStart_toStartOf="@+id/button9"
                        app:layout_constraintTop_toBottomOf="@+id/button10" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.cardview.widget.CardView>

            <ImageView
                android:id="@+id/imageView13"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:src="@drawable/vector"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

</FrameLayout>